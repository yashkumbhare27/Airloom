# Airloom – Environment Variables

## Frontend (.env in airloom/)
# Required for AI features (optional – falls back to on-device Gemini Nano or offline template)
VITE_PROXY_URL=/api

# Optional: Google Maps key (referrer-restricted to your domain)
# VITE_MAPS_KEY=your_google_maps_key_here

# Optional: Cloud AI model override
# VITE_CLOUD_MODEL=gemini-2.0-flash

## Backend (proxy/.env or Cloud Run environment)
# Your Gemini API key (server-side only, never in frontend bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Restrict CORS to your deployed domain
# ALLOWED_ORIGINS=https://yourapp.com

# Cloud model (server-side)
CLOUD_MODEL=gemini-2.0-flash
